{
  "name": "vodka",
  "description": "Chrome extension to download Kick VODs as MP4 in any quality — any length, constant memory.",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "bun test",
    "verify:mux": "bun scripts/verify-mux.ts",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "m3u8-parser": "^7.2.0",
    "mux.js": "^6.3.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wxt": "^0.20.27"
  }
}
